# Gnani voice. Create a key at https://app.gnani.ai/voice/
# Without this key, the phone's own speech recognition and voice are used.
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_SPEED=0.92

# Optional. Unlocks answers in every selected language, and reading a photo of a paper.
# Any OpenAI-compatible endpoint works. Leave blank to use the built-in Hindi and English guides.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
