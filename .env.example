# Gnani voice. Create a key at https://app.gnani.ai/voice/
# Without this key, the phone's own speech recognition and voice are used.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_SPEED=0.92

# Optional. Unlocks AI-generated answers in every selected language, and reading a photo of a paper.
# Any OpenAI-compatible endpoint works (including Gemini via OpenAI compatibility, Ollama, Groq, etc.).
# Leave blank to use the built-in regional guides across all 10 supported Indian languages.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
